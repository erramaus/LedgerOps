QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
PORT=3001
# Exact public URL of the app; must be https in production. Local dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication. If any value is missing the server logs which one and rejects all protected requests with 401.
# Long random string (32+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# OpenID Connect provider (Auth0, Okta, Microsoft Entra ID, ...). Allowed callback URL: ${FRONTEND_URL}/api/auth/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated emails allowed to sign in. Everyone else is denied even if the provider authenticates them.
AUTH_ALLOWED_EMAILS=
# Postgres session store. Required in production; on Render use the database's Internal Database URL.
DATABASE_URL=

# Leave empty for same-origin (Render, or local dev through the Vite proxy). Only the GitHub Pages build sets it (see .env.production).
VITE_API_BASE_URL=

# LOCAL DEVELOPMENT ONLY. Skips sign-in for demo routes when ALL of these hold: this is exactly "true", NODE_ENV=development,
# FRONTEND_URL is http://localhost or http://127.0.0.1, and no Render/GitHub/CI environment is detected. See docs/AUTHENTICATION.md.
# Never set this on Render. QuickBooks routes always require a real sign-in.
# NODE_ENV=development
# LEDGEROPS_DEV_BYPASS_AUTH=true
